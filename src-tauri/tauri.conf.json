{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LumSMP Launcher",
  "version": "2.8.0",
  "identifier": "tr.lumsmp.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LumSMP Launcher",
        "width": 1200,
        "height": 720,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0b0c15"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://mc-heads.net https://cdn.modrinth.com https://lumcraft.com.tr; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": {
      "../launcher.config.json": "launcher.config.json",
      "../src/bundled/lumsmp-client.jar": "bundled/lumsmp-client.jar"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
